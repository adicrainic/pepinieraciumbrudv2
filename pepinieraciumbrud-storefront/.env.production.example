# Pepinieraciumbrud Storefront — Production Environment Reference
# Rename or copy to .env on your production server

# WooCommerce Store API base (HTTPS production URL)
NUXT_PUBLIC_API_BASE=https://api.pepinieraciumbrud.ro/wp-json/wc/store/v1

# WooCommerce WordPress base
NUXT_PUBLIC_WP_BASE=https://api.pepinieraciumbrud.ro/wp-json

# Site base URL
NUXT_PUBLIC_SITE_URL=https://pepinieraciumbrud.ro

# Server runtime
PORT=3000
NODE_ENV=production

