# Pepinieraciumbrud Storefront — Environment Reference
# These are PUBLIC runtime values (safe to expose).
# API secrets are NEVER stored here — they live in wp-config.php only.

# WooCommerce Store API base (for public storefront — no auth required)
NUXT_PUBLIC_API_BASE=http://localhost/pepinieraciumbrudV2/pepinieraciumbrudshop/wp-json/wc/store/v1

# WooCommerce WordPress base (for page content, etc.)
NUXT_PUBLIC_WP_BASE=http://localhost/pepinieraciumbrudV2/pepinieraciumbrudshop/wp-json

# Site base URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

